<?xml version="1.0"?>
<sdf version="1.8">
  <world name="maze_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- The ground plane is written out here so the world starts with no network.
         The course maze generator wrote a Fuel include for it, which needs a download
         on the first run. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="maze">
      <pose>0 0 0 0 0 0</pose>
		  <link name='Wall_0'>
		    <collision name='Wall_0_Collision'>
		      <geometry><box><size>4.1 0.1 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_0_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>4.1 0.1 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.0 1.6 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_1'>
		    <collision name='Wall_1_Collision'>
		      <geometry><box><size>4.1 0.1 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_1_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>4.1 0.1 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.0 -1.6 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_2'>
		    <collision name='Wall_2_Collision'>
		      <geometry><box><size>0.1 3.3 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_2_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 3.3 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>-2.0 0.0 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_3'>
		    <collision name='Wall_3_Collision'>
		      <geometry><box><size>0.1 3.3 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_3_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 3.3 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>2.0 0.0 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_4'>
		    <collision name='Wall_4_Collision'>
		      <geometry><box><size>0.1 0.45 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_4_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 0.45 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.8 -1.375 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_5'>
		    <collision name='Wall_5_Collision'>
		      <geometry><box><size>0.1 0.65 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_5_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 0.65 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.8 -0.525 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_6'>
		    <collision name='Wall_6_Collision'>
		      <geometry><box><size>0.1 0.55 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_6_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 0.55 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.8 0.475 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_7'>
		    <collision name='Wall_7_Collision'>
		      <geometry><box><size>0.1 0.35 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_7_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 0.35 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>0.8 1.425 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_8'>
		    <collision name='Wall_8_Collision'>
		      <geometry><box><size>1.2 0.1 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_8_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>1.2 0.1 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>1.4 0.5 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_9'>
		    <collision name='Wall_9_Collision'>
		      <geometry><box><size>1.2 0.1 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_9_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>1.2 0.1 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>1.4 -0.5 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_10'>
		    <collision name='Wall_10_Collision'>
		      <geometry><box><size>2.0 0.1 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_10_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>2.0 0.1 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>-1.0 0.9 0 0 -0 0</pose>
		  </link>
		  <link name='Wall_11'>
		    <collision name='Wall_11_Collision'>
		      <geometry><box><size>0.1 1.2 1.5</size></box></geometry>
		      <pose>0 0 0.75 0 -0 0</pose>
		    </collision>
		    <visual name='Wall_11_Visual'>
		      <pose>0 0 0.75 0 -0 0</pose>
		      <geometry><box><size>0.1 1.2 1.5</size></box></geometry>
		      <material>
		        <diffuse>0.921569 0.807843 0.615686 1</diffuse>
		        <ambient>0.921569 0.807843 0.615686 1</ambient>
		      </material>
		    </visual>
		    <pose>-1.0 -1.0 0 0 -0 0</pose>
		  </link>
              <static>1</static>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>
</sdf>